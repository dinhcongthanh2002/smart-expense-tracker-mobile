# Base URL of the .NET API (V1), published on IIS at port 8081.
# ANDROID EMULATOR: the host PC is reached at 10.0.2.2 (localhost = the emulator itself).
# Physical phone: use the PC's Wi-Fi LAN IP instead, e.g. http://192.168.1.40:8081/api/v1
# EXPO_PUBLIC_* is inlined at bundle time — after changing this, restart Metro: npx expo start --clear
EXPO_PUBLIC_API_BASE_URL=http://mk.geneat.pro/api/v1
