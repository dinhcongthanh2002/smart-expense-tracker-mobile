# Base URL of the .NET API (V1), published on IIS at port 8081.
# ANDROID EMULATOR: the host PC is reached at 10.0.2.2 (localhost = the emulator itself).
# Physical phone: use the PC's Wi-Fi LAN IP instead, e.g. http://192.168.1.40:8081/api/v1
# EXPO_PUBLIC_* is inlined at bundle time — after changing this, restart Metro: npx expo start --clear
EXPO_PUBLIC_API_BASE_URL=http://mk.geneat.pro/api/v1

# Google Sign-In (OAuth client IDs from the same Google Cloud project the backend
# verifies against). WEB client id is REQUIRED — it is the idToken audience the API
# checks. IOS client id is used on iOS; its reversed form also goes in app.json
# (plugin "iosUrlScheme": "com.googleusercontent.apps.<ios-client-id>").
# Android needs the app's SHA-1 registered on an Android OAuth client (Google side).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=925669115467-okc0l1mgbs6q7qq90cc669juu3trc9k1.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=925669115467-7b5makgohg5qfmof8kfaju2ieh0umen7.apps.googleusercontent.com
